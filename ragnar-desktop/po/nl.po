msgid "Status Indicator"
msgstr "Status Aanwijzer"

#: src/panel/applets/status/StatusApplet.plugin.desktop.in:5
msgid "Show system status indicators, like sound, battery, and Bluetooth."
msgstr "Toon systeemstatus weergave zoals geluid, batterij en Bluetooth."

#: src/panel/applets/tasklist/TasklistApplet.plugin.desktop.in:4
msgid "Task List"
msgstr "Takenlijst"

#: src/panel/applets/tasklist/TasklistApplet.plugin.desktop.in:5
