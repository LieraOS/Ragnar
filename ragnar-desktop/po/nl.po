msgstr "Een takenlijst van de applicatie met pictogrammen en labels."

#: src/panel/applets/trash/TrashApplet.plugin.desktop.in:5
msgid "Manage your trash from the Ragnar panel"
msgstr "Beheer uw prullenbak vanaf het Ragnar Paneel"

#: src/panel/applets/tray/TrayApplet.plugin.desktop.in:4
msgid "System Tray"
msgstr "Systeemvak"

#: src/panel/applets/tray/TrayApplet.plugin.desktop.in:5
msgid ""
"System tray implementing the Freedesktop Status Notifier specification."
msgstr ""
"Systeemvak dat de Freedesktop Status Notifier-specificatie implementeert."

#: src/panel/applets/user-indicator/UserIndicator.plugin.desktop.in:4
msgid "User Indicator"
msgstr "Gebruikersindicator"

#: src/panel/applets/user-indicator/UserIndicator.plugin.desktop.in:5
msgid "Opens the power dialog."
msgstr "Opent het dialoogvenster Vergrendelen."

#: src/panel/applets/workspaces/WorkspacesApplet.plugin.desktop.in:4
msgid "Workspace Switcher"
msgstr "Werkblad Wisselaar"

#: src/panel/applets/workspaces/WorkspacesApplet.plugin.desktop.in:5
msgid "Display workspaces and switch between them."
msgstr "Werkbladen weergeven en wisselen."

