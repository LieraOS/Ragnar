#: src/panel/ragnar-desktop-settings.desktop.in.h:1
msgid "Ragnar Desktop Settings"
msgstr "Ragnar Настройки на работния плот"

msgid "Create new panel"
msgstr "Създаване на панел"

msgid "Windows"
msgstr "Прозорци"

msgid "Attach modal dialogs to windows"
msgstr "Прикачени към прозорците модални диалози"

msgid "Modal dialogs will become attached to the parent window and move together when dragged."
msgstr "Модалните диалогови прозорци ще са прикачени към главния прозорец и ще се движат заедно с него при влачене."

msgid "Button layout"
msgstr "Подредба на копчетата"

msgid "Change the layout of buttons in application titlebars."
msgstr "Промяна на подредбата на бутоните в заглавните ленти на приложенията."

msgid "Center new windows on screen"
msgstr "Центриране на новите прозорци на екрана"

msgid "Center newly launched windows on the current screen."
msgstr "Новите прозорци се отварят центрирани на текущия екран."

msgid "Disable Night Light mode when windows are fullscreen"
msgstr "Деактивиране на режима Нощна светлина, когато прозорците са на цял екран"

msgid "Disables Night Light mode when a window is fullscreen. Re-enables when leaving fullscreen."
msgstr "Деактивира режима Нощна светлина, когато прозорецът е на цял екран. Повторно активира при напускане на цял екран."

#, fuzzy
msgid "Pause notifications when windows are fullscreen"
msgstr "Деактивиране на режима Нощна светлина, когато прозорците са на цял екран"

#, fuzzy
msgid "Prevents notifications from appearing when a window is fullscreen. Unpauses when leaving fullscreen."
msgstr "Деактивира режима Нощна светлина, когато прозорецът е на цял екран. Повторно активира при напускане на цял екран."

msgid "Automatic tiling"
msgstr "Автоматично мозаично подреждане"

msgid "Windows will automatically tile when dragged into the top of the screen or the far corners."
msgstr "Прозорците се подреждат автоматично, когато са завлачени в горната част или в ъглите на екрана."

msgid "Enable window focus change on mouse enter and leave"
msgstr "Активиране на промяната на фокуса на прозореца при влизане и напускане на курсора на мишката"

msgid "Enables window focus to apply when the mouse enters the window and unfocus when the mouse leaves the window."
msgstr "Автоматично фокусира прозореца под курсора на мишката."

msgid "Disable unredirection of windows"
msgstr "Активиране на пренасочването на прозорци"

msgid "This option is for advanced users. Use this if you are having graphical or performance issues with dedicated GPUs."
msgstr "Опция за напреднали потребители. Използва се при графични проблеми или проблеми с производителността на дискретни графични карти."

#, fuzzy
msgid "Show all windows in tab switcher"
msgstr "Показване на всички прозорци при кликване"

msgid "All tabs will be displayed in tab switcher regardless of the workspace in use."
msgstr ""

msgid "Right (standard)"
msgstr "Дясно (стандартно)"

msgid "Left"
msgstr "Ляво"

msgid "Style"
msgstr "Стил"

msgid "Widgets"
msgstr "Елементи"

msgid "Set the appearance of window decorations and controls"
msgstr "Задайте вида на декорациите и контролите на прозорците"

msgid "Icons"
msgstr "Икони"

msgid "Set the globally used icon theme"
msgstr "Задайте глобално използваната тема на иконите"

msgid "Cursors"
msgstr "Курсори"

msgid "Set the globally used mouse cursor theme"
msgstr "Задайте глобално използваната тема на курсора на мишката"

msgid "Notification Position"
msgstr "Позиция на известията"

msgid "Set the location for notification popups"
msgstr "Задайте местоположението на изскачащите прозорци за известия"

msgid "Dark theme"
msgstr "Тъмна тема"

msgid "Built-in theme"
msgstr "Вградена тема"

msgid "When enabled, the built-in theme will override the desktop component styling"
msgstr "При активиране, стилът на графичните компоненти ще бъде заменен от вградената тема"

msgid "Animations"
msgstr "Анимации"

msgid "Control whether windows and controls use animations"
msgstr "Изберете дали прозорците и контролите използват анимации"

msgid "Top Left"
msgstr "Горе вляво"

msgid "Bottom Left"
msgstr "Долу вляво"

msgid "Bottom Right"
msgstr "Долу вдясно"

msgid "Top Right"
msgstr "Горе вдясно"

msgid "Set Raven position"
msgstr ""

msgid "Set which side of the screen Raven will open on. If set to Automatic, Raven will open where its parent panel is."
msgstr ""

msgid "Allow raising volume above 100%"
msgstr "Разреши увеличаване на звука над 100%"

msgid "Allows raising the volume via Sound Settings as well as the Sound Output Widget in Raven up to 150%."
msgstr "Разрешава увеличаване на звука до 150% в настройките на звука и в звуковия панел в Raven."

msgid "Enable display of week numbers in Calendar"
msgstr "Включи показване на номера на седмицата в календара"

msgid "This setting enables the display of week numbers in the Calendar widget."
msgstr "Тази настройка включва показването на номерата на седмиците в календара."

msgid "Show Calendar Widget"
msgstr "Покажи календара"

msgid "Shows or hides the Calendar Widget in Raven's Applets section."
msgstr "Показва или скрива календара в раздела с аплети на Raven."

msgid "Show Sound Output Widget"
msgstr "Покажи панела за изход на звука"

msgid "Shows or hides the Sound Output Widget in Raven's Applets section."
msgstr "Показва или скрива панела за изход на звука в раздела с аплети на Raven."

msgid "Show Microphone Input Widget"
msgstr "Покажи панела за вход от микрофона"

msgid "Shows or hides the Microphone Input Widget in Raven's Applets section."
msgstr "Показва или скрива панела за вход от микрофона в раздела с аплети на Raven."

msgid "Show Media Playback Controls Widget"
msgstr "Покажи панела за управление на медийно възпроизвеждане"

msgid "Shows or hides the Media Playback Controls (MPRIS) Widget in Raven's Applets section."
msgstr "Показва или скрива панела за управление на медийно възпроизвеждане в раздела с аплети на Raven."

msgid "Show Power Strip"
msgstr "Показване на панела за управление на захранването"

msgid "Shows or hides the Power Strip in the bottom of Raven."
msgstr "Показва или скрива панела за управление на захранването в долната част на Raven."

msgid "Choose an applet"
msgstr "Избор на аплет"

