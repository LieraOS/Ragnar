#: src/panel/ragnar-desktop-settings.desktop.in.h:1
msgid "Ragnar Desktop Settings"
msgstr "Configuración del Escritorio Ragnar"

msgid "Create new panel"
msgstr "Crear un panel nuevo"

msgid "Windows"
msgstr "Ventanas"

msgid "Attach modal dialogs to windows"
msgstr "Adjuntar cuadros de diálogo modales a ventanas"

msgid "Modal dialogs will become attached to the parent window and move together when dragged."
msgstr "Los diálogos modales se adjuntarán a la ventana principal y se moverán juntos cuando se les arrastre."

msgid "Button layout"
msgstr "Diseño de botón"

msgid "Change the layout of buttons in application titlebars."
msgstr "Cambiar el diseño de los botones en las barras de título de las aplicaciones."

msgid "Center new windows on screen"
msgstr "Centrar ventanas nuevas en la pantalla"

msgid "Center newly launched windows on the current screen."
msgstr "Centrar las ventanas recién lanzadas en la pantalla actual."

msgid "Disable Night Light mode when windows are fullscreen"
msgstr "Desactivar modo de luz nocturna cuando las ventanas estén a pantalla completa"

msgid "Disables Night Light mode when a window is fullscreen. Re-enables when leaving fullscreen."
msgstr "Desactivar modo de luz nocturna cuando una ventana está en pantalla completa. Reactivar cuando sale de pantalla completa."

#, fuzzy
msgid "Pause notifications when windows are fullscreen"
msgstr "Desactivar modo de luz nocturna cuando las ventanas estén a pantalla completa"

#, fuzzy
msgid "Prevents notifications from appearing when a window is fullscreen. Unpauses when leaving fullscreen."
msgstr "Desactivar modo de luz nocturna cuando una ventana está en pantalla completa. Reactivar cuando sale de pantalla completa."

msgid "Automatic tiling"
msgstr "Acomodo automático"

msgid "Windows will automatically tile when dragged into the top of the screen or the far corners."
msgstr "Las ventanas se acomodarán automáticamente cuando se arrastren a la parte superior o a las esquinas de la pantalla."

msgid "Enable window focus change on mouse enter and leave"
msgstr "Habilitar el cambio de enfoque de la ventana en el ratón al entrar y salir"

msgid "Enables window focus to apply when the mouse enters the window and unfocus when the mouse leaves the window."
msgstr "Permite que el enfoque de la ventana se aplique cuando el ratón entra en la ventana y se desenfoca cuando el ratón abandona la ventana."

msgid "Disable unredirection of windows"
msgstr "Deshabilitar la redirección de ventanas"

msgid "This option is for advanced users. Use this if you are having graphical or performance issues with dedicated GPUs."
msgstr "Esta opción es para usuarios avanzados. Utilícela si tiene problemas gráficos o de rendimiento con GPU dedicados."

msgid "Show all windows in tab switcher"
msgstr "Mostrar todas las ventanas en el cambiador de pestañas"

msgid "All tabs will be displayed in tab switcher regardless of the workspace in use."
msgstr "Todas las pestañas se mostrarán en el cambiador de pestañas a pesar del área de trabajo en uso."

msgid "Right (standard)"
msgstr "Derecha (estándar)"

msgid "Left"
msgstr "Izquierda"

msgid "Style"
msgstr "Estilo"

msgid "Widgets"
msgstr "Widgets"

msgid "Set the appearance of window decorations and controls"
msgstr "Establecer la apariencia de la decoración de ventanas y controles"

msgid "Icons"
msgstr "Íconos"

msgid "Set the globally used icon theme"
msgstr "Establecer el tema global de íconos"

msgid "Cursors"
msgstr "Cursores"

msgid "Set the globally used mouse cursor theme"
msgstr "Establecer el tema global de cursores del ratón"

msgid "Notification Position"
msgstr "Posición de notificaciones"

msgid "Set the location for notification popups"
msgstr "Establecer la ubicación de los popups de notificación"

msgid "Dark theme"
msgstr "Tema obscuro"

msgid "Built-in theme"
msgstr "Tema incorporado"

msgid "When enabled, the built-in theme will override the desktop component styling"
msgstr "Cuando está activado, el estilo de los componentes del escritorio será anulado por el tema incorporado"

msgid "Animations"
msgstr "Animaciones"

msgid "Control whether windows and controls use animations"
msgstr "Controla si las ventanas y controles usan animaciones"

msgid "Top Left"
msgstr "Esquina superior izquierda"

msgid "Bottom Left"
msgstr "Esquina inferior izquierda"

msgid "Bottom Right"
msgstr "Esquina inferior derecha"

msgid "Top Right"
msgstr "Esquina superior derecha"

msgid "Set Raven position"
msgstr "Establecer la posición de Raven"

msgid "Set which side of the screen Raven will open on. If set to Automatic, Raven will open where its parent panel is."
msgstr "Establecer en qué lado de la pantalla se abrirá Raven. Si se establece en automático, Raven se abrirá donde está el panel principal."

msgid "Allow raising volume above 100%"
msgstr "Permitir que el volumen suba por encima de 100%"

msgid "Allows raising the volume via Sound Settings as well as the Sound Output Widget in Raven up to 150%."
msgstr "Permitir que el volumen suba por medio de la configuración de sonido, así como el complemento de salida en Raven hasta 150%."

msgid "Enable display of week numbers in Calendar"
msgstr "Mostrar el número de la semana en el Calendario"

msgid "This setting enables the display of week numbers in the Calendar widget."
msgstr "Esta configuración permite mostrar el número de semana en el complemento de Calendario."

msgid "Show Calendar Widget"
msgstr "Mostrar complemento de Calendario"

msgid "Shows or hides the Calendar Widget in Raven's Applets section."
msgstr "Mostrar u ocultar el complemento de Calendario en la sección de applets de Raven."

msgid "Show Sound Output Widget"
msgstr "Mostrar Complemento de salida de sonido"

msgid "Shows or hides the Sound Output Widget in Raven's Applets section."
msgstr "Mostrar u ocultar el complemento de salida de sonido en la sección Applets de Raven."

msgid "Show Microphone Input Widget"
msgstr "Mostrar Complemento de Entrada de Micrófono"

msgid "Shows or hides the Microphone Input Widget in Raven's Applets section."
msgstr "Mostrar u ocultar el complemento de entrada del micrófono en la sección de Applets de Raven."

msgid "Show Media Playback Controls Widget"
msgstr "Mostrar el Complemento de los Controles de Reproducción Multimedia"

msgid "Shows or hides the Media Playback Controls (MPRIS) Widget in Raven's Applets section."
msgstr "Mostrar u ocultar el complemento de los controles de reproducción multimedia (MPRIS) en los Applets de Raven."

msgid "Show Power Strip"
msgstr "Mostrar la regleta"

msgid "Shows or hides the Power Strip in the bottom of Raven."
msgstr "Mostrar u ocultar la tira de energía en la parte inferior de Raven."

msgid "Choose an applet"
msgstr "Elegir un applet"

