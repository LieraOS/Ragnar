# Rust build artifacts
target/
*.deb
*.buildinfo
*.changes

# Debian packaging staging (generated by dpkg-buildpackage)
debian/tmp/
debian/*-stamp
debian/*.debhelper*
debian/*.substvars
debian/files
debian/.pc/
obj-*/

# Editor/OS noise
*~
.DS_Store

# pkg staging trees: build-deb.sh copies compiled binaries + generated
# .mo into pkg/ — keep the hand-maintained skeleton (DEBIAN/, services,
# .desktop, conf) in the repo, never the build output.
*/pkg/**/usr/bin/
*.mo
*/pkg/**/*.so

# vendored reference dump inside ragnar-skald (29 MB upstream source,
# not ours — kept only in the local working tree)
ragnar-skald/eeffect/
ragnar-skald/pipewire/
